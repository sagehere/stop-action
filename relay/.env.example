# Server
HOST=127.0.0.1
PORT=8787
STATIC_ROOT=..

# OpenAI Responses API. Keep secrets server-side.
OPENAI_API_KEY=
# Or mount a secret file instead of using OPENAI_API_KEY directly:
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
OPENAI_MODEL=gpt-6-astra
ALLOWED_MODELS=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional browser -> Relay authentication.
RELAY_BEARER_TOKEN=
# RELAY_BEARER_TOKEN_FILE=/run/secrets/relay_bearer_token

# Optional comma-separated cross-origin PWA origins.
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=
TRUST_PROXY=0

# Relay limits
BODY_LIMIT_BYTES=98304
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
RATE_LIMIT_BACKEND=memory
# Production multi-instance mode:
# RATE_LIMIT_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=1200
RATE_LIMIT_FAIL_CLOSED=0
RATE_LIMIT_PREFIX=coach_rl

# Upstream timeout/retry budget
UPSTREAM_TIMEOUT_MS=18000
UPSTREAM_TOTAL_TIMEOUT_MS=30000
# Max 2. Temporary 429/503 retries honor Retry-After when supplied.
UPSTREAM_RETRY_COUNT=0

# Local contract test / demo. Never calls OpenAI.
MOCK_OPENAI=0
