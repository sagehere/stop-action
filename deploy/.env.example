# Published image from this repository's GitHub Container Registry.
STOP_ACTION_IMAGE=ghcr.io/sagehere/stop-action:latest

# Bind locally by default. If your external NPM/Caddy runs in another container
# and cannot reach host loopback, set APP_BIND=0.0.0.0 and protect the port with firewall rules.
APP_BIND=127.0.0.1
APP_PORT=8787

# Public origin(s) served by your separately managed reverse proxy.
# Multiple origins are comma-separated.
ALLOWED_ORIGINS=https://training.example.com

OPENAI_MODEL=gpt-5.6-luna
ALLOWED_MODELS=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
RATE_LIMIT_FAIL_CLOSED=1
REDIS_CONNECT_TIMEOUT_MS=1200
UPSTREAM_TIMEOUT_MS=18000
UPSTREAM_TOTAL_TIMEOUT_MS=30000
UPSTREAM_RETRY_COUNT=1
